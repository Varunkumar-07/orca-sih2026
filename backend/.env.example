# ORCA backend environment variables
# Copy this file to .env in the same directory (backend/.env) and fill in a real value.
# The backend runs fully in demo mode WITHOUT any key — using cached golden fixtures
# via POST /query/demo and POST /query/full fallback. Only set GROQ_API_KEY for live LLM path.

# Used by all four reasoning agents (Planning, Marine Data Discovery,
# Weather Intelligence, Risk Assessment) — https://console.groq.com/keys
# When unset, /query/full gracefully falls back to fixture demo — ideal for hackathon presentation.
GROQ_API_KEY=your-groq-key-here

# Only used by the one-time/periodic backend/scripts/fetch_mpa_boundaries.py
# script — get a free key at https://api.protectedplanet.net/request.
# NOT required to run the backend: geospatial.py reads the local GeoJSON
# cache that script produces (backend/agents/deterministic/data/mpa_boundaries.geojson),
# never this key, and falls back to hardcoded boundaries if that cache is missing.
PROTECTED_PLANET_API_KEY=your-protected-planet-key-here

# Used by language_agent.py's Bhashini integration (translation, both input
# and output sides of every query). Register at https://bhashini.gov.in,
# open "My Profile" -> "API Key" -> Generate, and copy the User ID and ULCA
# API Key shown there (these authenticate the Pipeline Config call; the
# per-language-pair inference key used for the actual translation call is
# returned dynamically by that call itself, not something you set here).
# When unset, language_agent.py degrades gracefully: language is still
# detected locally (no key needed for that), but translation is skipped and
# the pipeline runs in English end-to-end — same "demo works with zero keys"
# guarantee as GROQ_API_KEY above.
BHASHINI_USER_ID=your-bhashini-user-id-here
BHASHINI_ULCA_API_KEY=your-bhashini-ulca-api-key-here

# Used by marine_data_agent.py's live chlorophyll lookup (Copernicus Marine
# Service, OCEANCOLOUR_GLO_BGC_L4_NRT_009_102) AND the shared live PFZ
# front-detection cache in pfz_service.py (backend/README.md's "PFZ zone
# detection" section) — read by chat, Zones Explorer (GET /zones), /route,
# /alerts, /weather/forecast, and /export. Free account, signed up at
# https://data.marine.copernicus.eu/register.
# When unset (or when a live fetch fails): chlorophyll comes back as None
# and PFZ zones come back empty for the affected anchor/query — there is
# no mock/sample fallback, so a missing or failing credential shows up as
# genuinely missing data rather than fabricated data presented as real.
COPERNICUSMARINE_USERNAME=your-copernicusmarine-username-here
COPERNICUSMARINE_PASSWORD=your-copernicusmarine-password-here

# Phase 8: PostgreSQL connection string for the history persistence layer
# (backend/history/) — logs every lookup/query across the 8 frontend pages
# for the History page to browse. Async driver required (asyncpg), since
# main.py's handlers are all `async def`.
# When unset, history logging degrades to a no-op — GET /history and
# GET /history/{id} return empty results, and none of the other 8 pages
# are affected — same "demo works with zero keys/services" guarantee as
# GROQ_API_KEY above.
# Local setup: `createdb orca_dev` then run `alembic upgrade head` from backend/.
DATABASE_URL=postgresql+asyncpg://your-db-user@localhost:5432/orca_dev

# Per-client-IP request rate limiting (backend/rate_limit.py). Opt-OUT, not
# opt-in — defaults to enabled with a generous limit even if neither var
# below is set. Set RATE_LIMIT_ENABLED=false to disable entirely (the test
# suite does this itself, in backend/tests/conftest.py, since it fires
# hundreds of requests through one shared app instance).
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_PER_MINUTE=120

# Shared-secret API key (backend/auth.py) — closes the "every endpoint is
# unauthenticated, anyone can read GET /history" audit finding. Opt-IN, not
# opt-out (same "demo works with zero keys" guarantee as every credential
# above) — when unset, every route stays open exactly as before. Once set,
# every request except GET /health must carry a matching X-API-Key header.
# The frontend sends this via VITE_ORCA_API_KEY (frontend/.env.example,
# frontend/src/lib/apiFetch.ts) — set both to the SAME value, or the
# frontend's own requests will get 401'd.
# ORCA_API_KEY=your-long-random-secret-here

# Max accepted request body size in bytes (backend/main.py), checked via
# Content-Length before any route or middleware reads the body. Defaults to
# 2 MiB if unset.
# MAX_REQUEST_BODY_BYTES=2097152
